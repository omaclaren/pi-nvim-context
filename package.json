{
  "name": "pi-nvim-context",
  "version": "0.3.2",
  "description": "Bridge Neovim to standalone Pi sessions for accumulated context and explicit model-powered editor suggestions",
  "type": "module",
  "license": "MIT",
  "author": "Oliver Maclaren",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omaclaren/pi-nvim-context.git"
  },
  "homepage": "https://github.com/omaclaren/pi-nvim-context#readme",
  "bugs": {
    "url": "https://github.com/omaclaren/pi-nvim-context/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "neovim",
    "editor-context",
    "coding-agent",
    "lua",
    "ai"
  ],
  "files": [
    "index.ts",
    "completion.ts",
    "CHANGELOG.md",
    "CHEATSHEET.md",
    "assets/pi-nvim-context-preview.webp",
    "lua",
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/omaclaren/pi-nvim-context/main/assets/pi-nvim-context-preview.webp"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "test": "npm run test:extension && npm run test:nvim",
    "test:extension": "node --import tsx --test tests/extension.test.ts",
    "test:nvim": "nvim --headless -u NONE -l tests/nvim_test.lua",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.4",
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
